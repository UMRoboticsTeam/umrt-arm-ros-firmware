<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="can_ppm_ros2_control" params="name">

    <!-- This xacro file isn't loaded by our urdf yet,
         so I have copied it into the arm's ros2_control xacro. -->
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>umrt-arm-ros-firmware/ServoControlSystem</plugin>
        <param name="global_subscription_prefix">/arm/ppm</param>
        <param name="babbler_prefix">/arm/babbler</param>
        <param name="ppm_gateway_id">0</param>
      </hardware>

      <joint name="gripper_servo">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <param name="id">0</param>
        <param name="initial_position">0.5</param>
      </joint>
      <joint name="gripper_solenoid">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <param name="id">1</param>
        <param name="initial_position">0.5</param>
      </joint>
    </ros2_control>

  </xacro:macro>

</robot>
