<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- macro for wheel joints -->
  <xacro:macro name="wheel_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- macro for diff_bot_ros2_control: for name, prefix, and simulation -->
  <xacro:macro name="diffbot_ros2_control" params="name prefix use_mock_hardware">
    <ros2_control name="${name}" type="system">

      <!-- false: Use Hardware -->
      <xacro:unless value="${use_mock_hardware}">
        <hardware>
          <plugin>umrt_arm_ros_firmware/DrivetrainControlSystem</plugin>

          <!-- Configurations -->
          <param name="can_interface">can0</param>
          <param name="rover_speed_topic">/umrt_ros_controller/RoverSpeedControl/tx</param>
          <param name="param_wheel_radius">0.17</param>
        </hardware>
      </xacro:unless>
      
      <!-- true: Use Simulation -->
      <xacro:if value="${use_mock_hardware}">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:if>

      <!-- Wheel Joints-->
      <xacro:wheel_joint name="${prefix}front_left_wheel_joint"/>
      <xacro:wheel_joint name="${prefix}rear_left_wheel_joint"/>
      <xacro:wheel_joint name="${prefix}front_right_wheel_joint"/>
      <xacro:wheel_joint name="${prefix}rear_right_wheel_joint"/>

    </ros2_control>
  </xacro:macro>

</robot>