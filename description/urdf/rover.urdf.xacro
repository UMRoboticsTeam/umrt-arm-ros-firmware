<?xml version="1.0"?>
<!-- Basic differential drive mobile base -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffdrive_robot">
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_mock_hardware" default="false" />

  <xacro:include filename="$(find umrt-arm-ros-firmware)/ros2_control_demo_description/project_perry/urdf/rover_description.urdf.xacro" />

  <!-- Import Rviz colors -->
  <xacro:include filename="$(find umrt-arm-ros-firmware)/ros2_control_demo_description/project_perry/urdf/rover.materials.xacro" />

  <!-- Import diffbot ros2_control description -->
  <xacro:include filename="$(find umrt-arm-ros-firmware)/ros2_control/rover.ros2_control.xacro" />

  <xacro:diffbot prefix="$(arg prefix)" />

  <xacro:diffbot_ros2_control
    name="UMRT 2026 Rover" prefix="$(arg prefix)" use_mock_hardware="$(arg use_mock_hardware)"/>

</robot>
